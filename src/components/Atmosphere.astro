---
import { Image } from 'astro:assets';
import interiorImage from '../assets/images/interior.jpg';
---

<div class="relative h-[30vh] min-h-[280px] overflow-hidden bg-ochre-dark">
  <Image
    src={interiorImage}
    alt="Blick in die Küche und den Tresen von The Base"
    class="w-full h-full object-cover"
    widths={[800, 1200, 1600, 2160]}
    sizes="100vw"
    loading="lazy"
    decoding="async"
  />
  <div
    class="absolute inset-0 flex items-end md:items-center px-6 md:px-10 pb-6 md:pb-0 bg-[linear-gradient(180deg,rgba(20,14,9,0.35),rgba(20,14,9,0.85))] md:bg-[linear-gradient(90deg,rgba(20,14,9,0.75)_0%,rgba(20,14,9,0.15)_55%,rgba(20,14,9,0.05)_100%)]"
  >
    <p
      class="font-display uppercase text-cream text-[clamp(24px,4vw,40px)] max-w-[480px] leading-tight text-balance [text-shadow:4px_4px_0_var(--color-chili)]"
    >
      Fastfood mit Handwerk und Leidenschaft
    </p>
  </div>
</div>
