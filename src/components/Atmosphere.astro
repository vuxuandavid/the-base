---
import { Image } from 'astro:assets';
import atmosphereImage from '../assets/images/atmosphere-banh-mi.jpg';
---

<div class="relative h-[35vh] min-h-[280px] overflow-hidden bg-ochre-dark">
  <Image
    src={atmosphereImage}
    alt="Bánh Mì mit Koriander, Gurke und Karotten auf Zeitungspapier"
    class="w-full h-full object-cover"
    widths={[800, 1200, 1600, 2160, 2560]}
    sizes="100vw"
    loading="lazy"
    decoding="async"
  />
  <div
    class="absolute inset-0 flex items-end px-6 md:px-10 pb-6 md:pb-10 bg-[linear-gradient(180deg,rgba(20,14,9,0)_40%,rgba(20,14,9,0.6)_100%),linear-gradient(90deg,rgba(20,14,9,0.75)_0%,rgba(20,14,9,0.15)_55%,rgba(20,14,9,0.05)_100%)]"
  >
    <div>
      <p
        translate="no"
        class="font-display uppercase text-cream text-[clamp(24px,4vw,40px)] leading-tight [text-shadow:4px_4px_0_var(--color-chili)]"
      >
        Ngon. Bổ. Rẻ.<br />
        Lecker. Nahrhaft. Günstig.<br />
        Ein vietnamesisches Sprichwort und unsere Grundprinzipien.
      </p>
    </div>
  </div>
</div>
