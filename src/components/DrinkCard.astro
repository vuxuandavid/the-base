---
import type { Drink } from '../data/menu';

interface Props {
  drink: Drink;
}

const { drink } = Astro.props;
---

<div class="bg-ochre-dark p-5">
  <p class="font-script text-cream text-[18px] mb-1">{drink.name}</p>
  <p class="mono text-[11px] text-cream-dim normal-case mb-3">{drink.desc}</p>
  <p class="font-mono font-semibold text-[15px] text-amber tabular-nums">{drink.price}</p>
</div>
