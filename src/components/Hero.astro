---
import { Image } from 'astro:assets';
import { marqueeItems } from '../data/menu';
import heroSource from '../assets/images/iron-bacon.jpg';

// Repeat so each half of the loop is wider than the viewport
const half = Array.from({ length: 4 }, () => marqueeItems).flat();
const items = [...half, ...half];
---

<section class="relative isolate pt-[160px] overflow-hidden bg-umber">
  <!-- Real <img> (not a CSS background) so the LCP image is discoverable early and sized per device -->
  <Image
    src={heroSource}
    alt=""
    class="absolute inset-0 -z-10 w-full h-full object-cover object-[center_65%]"
    widths={[480, 640, 828, 1080, 1440, 1920]}
    sizes="100vw"
    quality={55}
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />
  <div
    class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,rgba(20,14,9,0.55),rgba(20,14,9,0.86))]"
    aria-hidden="true"
  >
  </div>

  <div class="max-w-[1180px] mx-auto px-6 pb-[70px]">
    <h1
      translate="no"
      class="display text-cream text-[clamp(64px,11vw,150px)] mb-6 [text-shadow:6px_6px_0_var(--color-chili)]"
    >
      The<br />Base
      <span
        class="block mt-5 font-mono text-[13px] sm:text-[15px] tracking-[0.08em] text-amber leading-normal [text-shadow:none]"
      >
        Vietnamesisches Bánh Mì · Berlin-Mitte
      </span>
    </h1>

    <p class="font-medium text-cream-dim text-[19px] max-w-[480px] mb-8 leading-relaxed">
      Fast Food kann man auch anders machen, man kann daraus etwas Edles machen. Etwas, was die
      Leute genießen können mit gutem Gewissen. Das war der Leitfaden.
    </p>

    <div class="flex gap-4 flex-wrap">
      <a
        href="#karte"
        class="mono text-[13px] text-cream bg-chili border-2 border-cream px-6 py-4 shadow-[4px_4px_0_var(--color-umber)] transition-transform duration-150 hover:translate-x-0.5 hover:translate-y-0.5 hover:shadow-[2px_2px_0_var(--color-umber)]"
      >
        Zur Karte
      </a>
      <a
        href="#geschichte"
        class="mono text-[13px] text-cream bg-transparent border-2 border-cream-dim px-6 py-4 transition-colors hover:border-cream"
      >
        Unsere Geschichte
      </a>
    </div>
  </div>

  <div class="bg-chalk border-t-[3px] border-b-[3px] border-umber overflow-hidden py-3.5">
    <div class="flex w-max animate-marquee">
      {
        items.map((item) => (
          <span class="mono font-bold text-[18px] text-cream px-10 whitespace-nowrap">
            {item}
          </span>
        ))
      }
    </div>
  </div>
</section>
