---
import { Image } from 'astro:assets';
import type { MenuItem } from '../data/menu';

interface Props {
  item: MenuItem;
}

const { item } = Astro.props;
---

<article class="bg-ochre-dark relative overflow-hidden">
  <div class="w-full h-[190px] overflow-hidden bg-ochre">
    <Image
      src={item.image}
      alt={item.imageAlt}
      class="w-full h-full object-cover"
      widths={[400, 600, 900]}
      sizes="(min-width: 1024px) 380px, (min-width: 768px) 50vw, 100vw"
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="px-[22px] pt-6 pb-[22px]">
    <div class="mono text-[11px] text-amber mb-2.5">{item.code}</div>
    <h3 class="font-display uppercase text-[25px] leading-none text-cream mb-1.5">{item.name}</h3>
    <p class="font-script text-amber text-[16px] mb-3">{item.subtitle}</p>
    <p class="text-[14px] text-cream-dim mb-4 leading-relaxed">{item.desc}</p>
    <p class="mono text-[11px] text-[#a5927a] normal-case tracking-normal mb-4">
      {item.ingredients}
    </p>
    <div class="flex justify-between items-center border-t border-dashed border-line pt-3.5">
      <span class="font-mono font-semibold text-[17px] text-cream">{item.price}</span>
      <span class:list={['mono text-[10px] px-2 py-1', item.tagClass]}>{item.tag}</span>
    </div>
  </div>
</article>
