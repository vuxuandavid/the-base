---
interface Props {
  kicker: string;
  title: string;
  borderClass?: string;
  headingClass?: string;
  kickerClass?: string;
  level?: 'h1' | 'h2';
}

const {
  kicker,
  title,
  borderClass = 'border-umber',
  headingClass = 'text-umber',
  kickerClass = 'text-chili',
  level = 'h2',
} = Astro.props;

const Heading = level;
---

<div
  class:list={[
    'flex items-baseline justify-between flex-wrap gap-3 mb-12 border-b-[3px] pb-4',
    borderClass,
  ]}
>
  <div>
    <div class:list={['mono text-[12px] tracking-widest', kickerClass]}>{kicker}</div>
    <Heading class:list={['display leading-none text-[clamp(32px,5vw,54px)] mt-1.5 text-balance', headingClass]}>
      {title}
    </Heading>
  </div>
  <slot />
</div>
