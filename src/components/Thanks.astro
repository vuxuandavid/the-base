---
import SectionHead from './SectionHead.astro';
import { thanksList } from '../data/menu';
---

<section id="danke" class="w-full py-[88px] px-6 bg-chalk text-cream scroll-mt-20">
  <div class="max-w-[1180px] mx-auto">
    <SectionHead
      kicker="MIT DANK AN"
      title="Ohne euch keine Base"
      borderClass="border-amber"
      headingClass="text-cream"
      kickerClass="text-chili-light"
    />
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      {
        thanksList.map((entry) => (
          <div class="bg-ochre-dark border-l-4 border-amber px-6 py-5">
            <p class="font-display uppercase text-amber text-[18px] mb-2">{entry.name}</p>
            <p class="text-[14.5px] text-cream-dim leading-relaxed">{entry.note}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
