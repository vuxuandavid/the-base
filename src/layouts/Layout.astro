---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'The Base - Bánh Mì in Berlin',
  description = 'The Base bringt vietnamesisches Bánh Mì nach Berlin: frisch belegt, ehrlich zusammengestellt, für alle bezahlbar. Ngon. Bổ. Rẻ.',
} = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#181310" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[200] mono text-[13px] text-chalk bg-cream border-2 border-chalk px-4 py-2.5"
    >
      Zum Inhalt springen
    </a>
    <slot />
  </body>
</html>
