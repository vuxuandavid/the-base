---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import SectionHead from '../components/SectionHead.astro';
import Footer from '../components/Footer.astro';
---

<!-- Cloudflare Pages serves 404.html with a real 404 status; without it, unknown URLs fall back to the home page with 200 -->
<Layout title="Seite nicht gefunden - The Base" description="Diese Seite gibt es bei The Base Bánh Mì nicht.">
  <meta slot="head" name="robots" content="noindex" />
  <Nav />

  <main id="main-content" class="w-full pt-[160px] pb-[88px] px-6 bg-cream">
    <div class="max-w-[1180px] mx-auto">
      <SectionHead kicker="404" title="Seite nicht gefunden" level="h1" />

      <div class="max-w-[720px] text-[16px] leading-relaxed">
        <p class="mb-8">Diese Seite gibt es nicht. Das Bánh Mì aber schon.</p>
        <a
          href="/"
          class="inline-block font-mono uppercase text-[13px] tracking-wide bg-chili text-cream px-5 py-3 border-2 border-umber hover:bg-amber hover:text-umber transition-colors"
        >
          Zur Startseite
        </a>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
