---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import SectionHead from '../components/SectionHead.astro';
import PlaceholderNote from '../components/PlaceholderNote.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Impressum - The Base" description="Impressum von The Base Bánh Mì, Berlin.">
  <Nav />

  <main id="main-content" class="w-full pt-[160px] pb-[88px] px-6 bg-cream">
    <div class="max-w-[1180px] mx-auto">
      <SectionHead kicker="RECHTLICHES" title="Impressum" level="h1" />

      <div class="max-w-[720px] text-[16px] leading-relaxed">
        <PlaceholderNote>
          Bitte den vollständigen rechtlichen Namen (Inhaber:in bzw. Firma), eine ggf. vorhandene
          Umsatzsteuer-ID und, falls vorhanden, Handelsregisterdaten ergänzen, bevor die Seite
          live geht. Im Zweifel kurz mit einer Steuerberatung oder einem Impressum-Generator
          gegenprüfen.
        </PlaceholderNote>

        <h3 class="font-display uppercase text-[22px] text-chili mt-2 mb-3">
          Angaben gemäß § 5 TMG
        </h3>
        <p class="mb-1">The Base</p>
        <p class="mb-1">[Vollständiger Name des Betreibers / Firmenname]</p>
        <p class="mb-1">Oranienburger Str. 6</p>
        <p class="mb-6">10178 Berlin</p>

        <h3 class="font-display uppercase text-[22px] text-chili mt-8 mb-3">Kontakt</h3>
        <table class="w-full max-w-[420px] border-collapse font-mono text-[14px] mb-8">
          <tbody>
            <tr class="border-b border-dashed border-[rgba(43,29,18,0.2)]">
              <td class="py-2.5">Telefon</td>
              <td class="py-2.5 text-right">
                <a href="tel:+4915207078161" class="hover:text-chili transition-colors"
                  >01520 7078161</a
                >
              </td>
            </tr>
            <tr class="border-b border-dashed border-[rgba(43,29,18,0.2)]">
              <td class="py-2.5">E-Mail</td>
              <td class="py-2.5 text-right">
                <a href="mailto:hello@thebasebanhmi.de" class="hover:text-chili transition-colors"
                  >hello@thebasebanhmi.de</a
                >
              </td>
            </tr>
          </tbody>
        </table>

        <h3 class="font-display uppercase text-[22px] text-chili mt-8 mb-3">Umsatzsteuer-ID</h3>
        <p class="mb-8">[Umsatzsteuer-Identifikationsnummer gemäß § 27a UStG, falls vorhanden]</p>

        <h3 class="font-display uppercase text-[22px] text-chili mt-8 mb-3">
          Verantwortlich für den Inhalt
        </h3>
        <p class="mb-8">nach § 18 Abs. 2 MStV: [Name, Anschrift wie oben]</p>

        <h3 class="font-display uppercase text-[22px] text-chili mt-8 mb-3">
          EU-Streitschlichtung
        </h3>
        <p class="mb-8">
          Die Europäische Kommission stellt eine Plattform zur Online-Streitbeilegung (OS)
          bereit, abrufbar unter <a
            href="https://ec.europa.eu/consumers/odr/"
            target="_blank"
            rel="noopener noreferrer"
            class="underline hover:text-chili transition-colors">ec.europa.eu/consumers/odr</a
          >. Unsere E-Mail-Adresse finden Sie oben unter Kontakt.
        </p>

        <h3 class="font-display uppercase text-[22px] text-chili mt-8 mb-3">
          Verbraucherstreitbeilegung
        </h3>
        <p>
          Wir sind nicht bereit oder verpflichtet, an Streitbeilegungsverfahren vor einer
          Verbraucherschlichtungsstelle teilzunehmen.
        </p>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
